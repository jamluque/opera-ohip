# AWS
AWS_REGION=eu-west-1
AWS_DEFAULT_REGION=eu-west-1
AWS_PROFILE=your-aws-profile

# Runtime
APP_ENV=dev
LOG_LEVEL=INFO
METRICS_PORT=9100
HEALTH_PORT=8080

# Secrets Manager. The secret should be JSON with:
# {
#   "ohip_gateway_url": "https://<gateway-host>",
#   "ohip_streaming_ws_url": "wss://<gateway-host>/streaming/graphql",
#   "ohip_token_url": "https://<gateway-host>/oauth/v1/tokens",
#   "ohip_application_key": "<application-key-placeholder>",
#   "ohip_client_id": "<client-id-placeholder>",
#   "ohip_client_secret": "<client-secret-placeholder>",
#   "ohip_enterprise_id": "<enterprise-id-placeholder>",
#   "ohip_scope": "<scope-placeholder>",
#   "ohip_chain_code": "<chain-code-placeholder>",
#   "ohip_hotel_ids": "HOTEL1,HOTEL2",
#   "ohip_external_system_code": "AWS_BYOD"
# }
OHIP_SECRET_ID=/opera/ohip/dev/credentials

# OHIP placeholders for local execution without Secrets Manager.
# Never commit real secrets in this file.
OHIP_GATEWAY_URL=https://placeholder-gateway.example.com
OHIP_STREAMING_WS_URL=wss://placeholder-gateway.example.com/streaming/graphql
OHIP_TOKEN_URL=https://placeholder-gateway.example.com/oauth/v1/tokens
OHIP_APPLICATION_KEY=replace-me-application-key
OHIP_CLIENT_ID=replace-me-client-id
OHIP_CLIENT_SECRET=replace-me-client-secret
OHIP_ENTERPRISE_ID=replace-me-enterprise-id
OHIP_SCOPE=replace-me-scope
OHIP_CHAIN_CODE=CHAIN
OHIP_HOTEL_IDS=HOTEL1,HOTEL2
OHIP_EXTERNAL_SYSTEM_CODE=AWS_BYOD

# Listener -> SQS
SQS_EVENTS_QUEUE_URL=https://sqs.eu-west-1.amazonaws.com/123456789012/opera-ohip-dev-events.fifo
SQS_MESSAGE_GROUP_ID=opera-ohip-stream
SQS_DEDUP_WINDOW_SECONDS=300

# S3 raw and listener offsets
RAW_BUCKET=opera-ohip-dev-raw
RAW_PREFIX=ohip/events
OFFSET_PREFIX=ohip/offsets

# Aurora PostgreSQL
DATABASE_URL=postgresql://app_user:replace-me@opera-ohip-dev.cluster-xyz.eu-west-1.rds.amazonaws.com:5432/opera_ohip

# Listener tuning
OHIP_SUBSCRIPTION_NAME=opera-ohip-business-events
OHIP_RECONNECT_MIN_SECONDS=1
OHIP_RECONNECT_MAX_SECONDS=60
OHIP_PING_INTERVAL_SECONDS=20
OHIP_TOKEN_REFRESH_SKEW_SECONDS=120

# Consumer tuning
SQS_WAIT_TIME_SECONDS=20
SQS_MAX_MESSAGES=10
SQS_VISIBILITY_TIMEOUT=120
CONSUMER_IDLE_SLEEP_SECONDS=2

# Event enricher
ENRICHER_ROUTER_CONFIG=config/event-router.yaml
ENRICHER_MAX_ATTEMPTS=5
SQS_ENRICHER_DLQ_URL=https://sqs.eu-west-1.amazonaws.com/123456789012/opera-ohip-dev-events-dlq.fifo
CLOUDWATCH_METRICS_NAMESPACE=Opera/OHIP/Enrichment


# Analytics snapshots and pickup metrics
ANALYTICS_SNAPSHOT_DATE=
ANALYTICS_PICKUP_DAYS=1,3,7,15
ANALYTICS_STAY_HORIZON_DAYS=730
